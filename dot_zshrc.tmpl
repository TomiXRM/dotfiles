# ===== zshプラグイン (chezmoi externals管理: .chezmoiexternal.toml) =====
ZSH_PLUGINS="$HOME/.zsh/plugins"
fpath=("$ZSH_PLUGINS/zsh-completions/src" $fpath)

# ===== 補完設定 =====
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
setopt list_packed
autoload colors
zstyle ':completion:*' list-colors ''

# コマンドのスペルを訂正
setopt correct

# ===== mise (ログインシェル以外でも有効化) =====
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# ===== rustup/cargo (miseでは管理しない、rustup一本化) =====
[[ -r "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# ===== compinit =====
# キャッシュ(.zcompdump)が24時間より古い時だけフルスキャンする
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qNmh+24) ]]; then
  compinit
else
  compinit -C
fi

# compinit 後でないと compdef は使えないため、ここで定義する
compdef '_files' source # sourceの補完がファイル・ディレクトリのみになる

# uv補完 (旧oh-my-zsh uvプラグイン相当)
if command -v uv >/dev/null 2>&1; then
  eval "$(uv generate-shell-completion zsh)"
fi

# ===== 秘密の環境変数 (age暗号化、chezmoi管理) =====
[[ -r "$HOME/.config/ai/secrets.env" ]] && source "$HOME/.config/ai/secrets.env"

# ===== 標準設定 =====
HISTSIZE=10000
SAVEHIST=10000

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Starship prompt
if type starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# fd alias (fd-find on Ubuntu installs as fdfind)
if command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
  alias fd='fdfind'
fi

# bat alias (bat on Ubuntu installs as batcat)
if command -v batcat >/dev/null 2>&1 && ! command -v bat >/dev/null 2>&1; then
  alias bat='batcat'
fi

# zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# chezmoi completion
if command -v chezmoi >/dev/null 2>&1; then
  eval "$(chezmoi completion zsh)"
fi

# fzf shell integration
if command -v fzf >/dev/null 2>&1 && fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
elif [[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
  [[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
fi

# ===== プラグイン読み込み =====
[[ -r "$ZSH_PLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$ZSH_PLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh"
# NOTE: syntax-highlighting は他のZLE widget定義（fzf等）より後に読む必要がある
[[ -r "$ZSH_PLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$ZSH_PLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# ===== ROS2 設定（chezmoi feature flag管理） =====
{{- $features := get . "features" | default dict }}
{{- $ros2Enabled := get $features "ros2" | default false }}
{{- $embeddedEnabled := get $features "embedded" | default false }}
{{- $embedded := get . "embedded" | default dict }}
{{- $armNoneEabiVersion := get $embedded "armNoneEabiVersion" | default "15.2.1-1.1.1" }}
{{- if and $ros2Enabled (eq .chezmoi.os "linux") }}
# ROS2 (Linux only)
autoload -Uz bashcompinit
bashcompinit

ros_setup_found=false
for setup in /opt/ros/*/setup.zsh(N); do
  source "$setup"
  export ROS_DOMAIN_ID=7
  ros_setup_found=true

  # Enable ROS2 shell completion if available.
  if [[ -n "$ROS_DISTRO" ]] && [[ -r /opt/ros/$ROS_DISTRO/share/ros2cli/environment/ros2-argcomplete.zsh ]]; then
    source /opt/ros/$ROS_DISTRO/share/ros2cli/environment/ros2-argcomplete.zsh
  fi
  break
done

if [[ "$ros_setup_found" != true ]]; then
  echo "ROS2 feature is enabled, but no /opt/ros/*/setup.zsh was found." >&2
fi

{{- else if and $ros2Enabled (eq .chezmoi.os "darwin") }}
# ROS2 (MacOS only)
if type pixi >/dev/null 2>&1; then
  eval "$(pixi completion --shell zsh)"

  # pixi環境に入ったら補完を仕込む (シェルごとに一度)。
  # 旧実装は登録後に hook 自体を消していたが、pixi shell の起動タイミングや
  # 環境再インストール中に一度でも噛み合わないと、そのシェルでは二度と登録されず
  # 補完が静かに死ぬことがあった。フラグ式にして「成功するまで毎 prompt リトライ・
  # 成功後はガード 2 つで即 return」に変更 (負荷はほぼゼロ)。
  autoload -Uz add-zsh-hook
  _ros2_argcomplete_precmd() {
    [[ -z "${_ROS2_ARGCOMPLETE_DONE:-}" ]] || return
    [[ -n "${PIXI_ENVIRONMENT_NAME:-}" ]] || return
    command -v register-python-argcomplete >/dev/null 2>&1 || return

    autoload -Uz bashcompinit && bashcompinit
    # NOTE: `eval "$(cmd)" || return` では捕まらない。eval の終了コードは cmd ではなく
    # 評価された文字列のものなので、cmd が失敗して出力が空だと eval "" = 0 になり
    # すり抜ける。環境再インストール中の典型的な壊れ方がまさにそれなので、
    # 出力を変数で受けて「コマンドの成否」と「中身が空でないこと」を両方確かめる。
    local out
    out="$(register-python-argcomplete ros2 2>/dev/null)" || return
    [[ -n "$out" ]] || return
    eval "$out"
    eval "$(register-python-argcomplete colcon 2>/dev/null)"
    typeset -g _ROS2_ARGCOMPLETE_DONE=1
  }

  add-zsh-hook precmd _ros2_argcomplete_precmd
fi
{{- end }}

{{- if and $embeddedEnabled (eq .chezmoi.os "darwin") }}
# ===== 組み込み開発設定（chezmoi feature flag管理） =====
# Embedded development tools (Mac only)
export ARM_NONE_EABI_VERSION="{{ $armNoneEabiVersion }}"
export PATH="$HOME/Library/xPacks/@xpack-dev-tools/arm-none-eabi-gcc/${ARM_NONE_EABI_VERSION}/.content/bin:$PATH"
export PATH="/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/Resources/bin:$PATH"
{{- else if and $embeddedEnabled (eq .chezmoi.os "linux") }}
# ===== 組み込み開発設定（chezmoi feature flag管理） =====
# Embedded development tools (Linux only)
export ARM_NONE_EABI_VERSION="{{ $armNoneEabiVersion }}"
export PATH="$HOME/.local/xPacks/@xpack-dev-tools/arm-none-eabi-gcc/${ARM_NONE_EABI_VERSION}/.content/bin:$PATH"
export PATH="$HOME/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin:$PATH"
{{- end }}
